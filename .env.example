# Copy this file to ".env" and fill in your real values.
# The real .env is git-ignored, so your keys never reach GitHub.

# --- Azure OpenAI ---
# From the Azure portal: your resource -> "Keys and Endpoint".
# Endpoint looks like: https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_ENDPOINT=your-endpoint-here
AZURE_OPENAI_API_KEY=your-key-here

# The DEPLOYMENT names you chose in Azure AI Foundry (not the model names).
# These defaults match the deployments from the build; change if yours differ.
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small

# Stable GA API version. Leave as-is unless you have a reason to change it.
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Optional tuning (safe defaults; uncomment to override) ---
# LLM_MAX_TOKENS=1024
# LLM_TEMPERATURE=0.3
# KB_SIMILARITY_THRESHOLD=0.35
