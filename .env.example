# Copy this file to ".env" and fill in your real values.
# The real .env is git-ignored, so your keys never reach GitHub.

# --- Azure OpenAI ---
# From the Azure portal: your resource -> "Keys and Endpoint" (OpenAI tab).
# Endpoint looks like: https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_ENDPOINT=your-endpoint-here
AZURE_OPENAI_API_KEY=your-key-here

# The DEPLOYMENT names you chose in Azure AI Foundry (not the model names).
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small

# Stable GA API version. Leave as-is unless you have a reason to change it.
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Azure AI Search (vector store / RAG) ---
# From your Search resource: Overview -> "Url", and Settings -> Keys.
# Endpoint looks like: https://YOUR-SERVICE.search.windows.net
AZURE_SEARCH_ENDPOINT=your-search-endpoint-here
AZURE_SEARCH_API_KEY=your-search-key-here
AZURE_SEARCH_INDEX=helpdesk-faqs

$envblock = @'

# --- Microsoft Entra ID (sign-in) ---
AZURE_AUTH_CLIENT_ID=your-application-client-id
AZURE_AUTH_TENANT_ID=your-directory-tenant-id
'@
Add-Content -Path .env.example -Value $envblock
$snexample = @'

# --- ServiceNow (incident creation) ---
SERVICENOW_INSTANCE=https://devXXXXX.service-now.com
SERVICENOW_USER=admin
SERVICENOW_PASSWORD=your-instance-admin-password
'@
Add-Content -Path .env.example -Value $snexample
# --- Optional tuning (safe defaults; uncomment to override) ---
# LLM_MAX_TOKENS=1024
# LLM_TEMPERATURE=0.3
# KB_SIMILARITY_THRESHOLD=0.35
# EMBED_DIMENSIONS=1536
